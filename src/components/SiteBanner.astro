---
// Overrides Starlight's default Banner so a site-wide notice shows on every
// page, not just pages that set `banner` in frontmatter.
//
// Temporary — this exists only while visitors are getting used to the new site
// replacing the old one at synthedit.com. To remove it, delete this file and
// the `components.Banner` entry in astro.config.mjs.
const { banner } = Astro.locals.starlightRoute.entry.data;

const content =
	banner?.content ??
	'Welcome to the new SynthEdit website. The old site is still available — <a href="/old/">visit the old site</a>.';
---

<div class="sl-banner" data-pagefind-ignore set:html={content} />

<style>
	@layer starlight.core {
		.sl-banner {
			--__sl-banner-text: var(--sl-color-banner-text, var(--sl-color-text-invert));
			padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
			background-color: var(--sl-color-banner-bg, var(--sl-color-bg-accent));
			color: var(--__sl-banner-text);
			line-height: var(--sl-line-height-headings);
			text-align: center;
			text-wrap: balance;
			box-shadow: var(--sl-shadow-sm);
		}
		.sl-banner :global(a) {
			color: var(--__sl-banner-text);
		}
	}
</style>
