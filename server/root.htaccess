# Deployed copy lives at /domains/synthedit.com/public_html/.htaccess on the
# server. It is NOT uploaded by the GitHub Actions workflow (which only writes
# inside public_html/_site/), so any change here must be FTP'd up by hand.
#
# How the two sites share the domain:
#   * The new Astro site is built to public_html/_site/ and mapped onto the
#     domain root by the NEW SITE block below, but only for URLs where a
#     matching file actually exists in _site/.
#   * Every other URL falls through to the old SilverStripe CMS exactly as
#     before, so /purchase/, /demo/, /members/, /contact/, /downloads/,
#     /software-development-kit/, /modules/ etc. keep working untouched.
#   * The old home page is at /old/ ( = SilverStripe's /home/index/ ), because
#     "/" now belongs to the new site and SilverStripe 301s /home/ to "/".
#
# To roll back to the old site: delete the NEW SITE block. Nothing else here
# has been modified.

### NEW SITE START ###
<IfModule mod_rewrite.c>
	RewriteEngine On

	# Old /new/ links -> the same page at the domain root.
	# The (?:/(.*))? form matches "new" and "new/..." but NOT "new-docs/...".
	RewriteRule ^new(?:/(.*))?$ /$1 [R=301,L]

	# _site/ is an implementation detail: bounce direct hits to the clean URL.
	# The REDIRECT_STATUS guard makes this fire only for real browser requests,
	# so the internal rewrites at the bottom of this block don't loop.
	RewriteCond %{ENV:REDIRECT_STATUS} ^$
	RewriteRule ^_site/(.*)$ /$1 [R=301,L]
	RewriteRule ^_site/ - [L]

	# Old SilverStripe home page. /home/ 301s to "/", but /home/index/ does not.
	RewriteRule ^old/?$ framework/main.php?url=home/index [QSA,L]

	# Domain root -> new site's home page.
	RewriteCond %{DOCUMENT_ROOT}/_site/index.html -f
	RewriteRule ^$ /_site/index.html [L]

	# Astro emits directory-style URLs; add the missing trailing slash.
	RewriteCond %{DOCUMENT_ROOT}/_site/$1/index.html -f
	RewriteRule ^(.*[^/])$ /$1/ [R=301,L]

	# Serve from _site/ when the file is there, otherwise fall through to
	# SilverStripe below.
	RewriteCond %{DOCUMENT_ROOT}/_site/$1 -f
	RewriteRule ^(.*)$ /_site/$1 [L]
	RewriteCond %{DOCUMENT_ROOT}/_site/$1index.html -f
	RewriteRule ^(.*)$ /_site/$1index.html [L]
</IfModule>
### NEW SITE END ###

### SILVERSTRIPE START ###

# Deny access to templates (but allow from localhost)
<Files *.ss>
	Order deny,allow
	Deny from all
	Allow from 127.0.0.1
</Files>

# Deny access to IIS configuration
<Files web.config>
	Order deny,allow
	Deny from all
</Files>

<Files php.ini>
          Order allow,deny
          Deny from all
</Files>

# Deny access to YAML configuration files which might include sensitive information
<Files ~ "\.ya?ml$">
	Order allow,deny
	Deny from all
</Files>

# Route errors to static pages automatically generated by SilverStripe
ErrorDocument 404 /assets/error-404.html
ErrorDocument 500 /assets/error-500.html

<IfModule mod_rewrite.c>
	SetEnv HTTP_MOD_REWRITE On
	RewriteEngine On
#	RewriteBase '/~synth'

	# Deny access to potentially sensitive files and folders
	RewriteRule ^vendor(/|$) - [F,L,NC]
	RewriteRule silverstripe-cache(/|$) - [F,L,NC]
	RewriteRule composer\.(json|lock) - [F,L,NC]

	# Process through SilverStripe if no file with the requested name exists.
	# Pass through the original path as a query parameter, and retain the existing parameters.
	RewriteCond %{REQUEST_URI} ^(.*)$
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteRule .* framework/main.php?url=%1 [QSA]

	# If framework isn't in a subdirectory, rewrite to installer
	RewriteCond %{REQUEST_URI} ^(.*)/framework/main.php$
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteRule . %1/install.php? [R,L]

</IfModule>
### SILVERSTRIPE END ###
